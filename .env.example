# --- MinIO ---------------------------------------------------------------
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_PIPELINE_USER=pipelines
MINIO_PIPELINE_PASSWORD=change-me
MINIO_PIPELINE_ACCESS_KEY=change-me
MINIO_PIPELINE_SECRET_KEY=change-me
# Hors Docker uniquement (les conteneurs Airflow surchargent : http://minio:9000)
MINIO_ENDPOINT_URL=http://localhost:9000

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_DB=football
POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
# Port hôte (le conteneur écoute sur 5432 ; Airflow surcharge POSTGRES_HOST/PORT)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Airflow -------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=

# --- API football --------------------------------------------------------
RAPID_API_BASE_URL=https://api-football-v1.p.rapidapi.com/v3
X_RAPIDAPI_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
X_APISPORTS_KEY=